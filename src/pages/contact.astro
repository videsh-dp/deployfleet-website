---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { u } from '../lib/url';
import { SITE, INTEGRATIONS, appLinks } from '../data/site';
const endpoint = INTEGRATIONS.contactEndpoint;

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact Us', path: '/contact/' }];
---
<Base
  title="Contact DeployFleet"
  description="Questions about dispatching technicians or joining as a field tech? Contact the DeployFleet team."
  breadcrumbs={crumbs}
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact DeployFleet', url: `${SITE.url}/contact/` }]}
>
  <PageHero eyebrow="Contact us" title="Let’s get your locations covered" text="Tell us what you need, whether you’re a provider looking for coverage or a technician looking for quality work." crumbs={crumbs} />

  <section class="section section--soft">
    <div class="container contact-grid">
      <div>
        <h2>Get in touch</h2>
        <p class="lead">Need coverage today? The fastest way is to <a href={appLinks.registerCompany} style="color:var(--purple)">post a job</a> and dispatch the right tech.</p>
        <div class="contact-cards">
          <div class="contact-card">
            <span class="call-icon"><Icon name="mail" /></span>
            <div><h3>Email</h3><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
          </div>
          {SITE.phone && (
            <div class="contact-card">
              <span class="call-icon"><Icon name="phone" /></span>
              <div><h3>Phone</h3><a href={SITE.phoneHref}>{SITE.phone}</a></div>
            </div>
          )}
          <div class="contact-card">
            <span class="call-icon"><Icon name="clock" /></span>
            <div><h3>Dispatch hours</h3><p>On-demand, including after-hours and weekends.</p></div>
          </div>
        </div>
      </div>

      <form class="form" data-contact-form data-to={SITE.email} data-endpoint={endpoint} method="POST" novalidate>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
        <fieldset style="border:0;padding:0;margin:0">
          <legend class="field" style="font-size:.85rem;color:var(--ink);font-weight:600;padding:0;margin-bottom:7px">I am a</legend>
          <div class="segmented">
            <input type="radio" id="role-provider" name="role" value="Provider" checked />
            <label for="role-provider"><Icon name="building" class="seg-icon" />Provider / Company</label>
            <input type="radio" id="role-tech" name="role" value="Technician" />
            <label for="role-tech"><Icon name="wrench" class="seg-icon" />Technician</label>
          </div>
        </fieldset>
        <div class="form-row">
          <div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" /></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field">
          <label for="topic">Topic</label>
          <select id="topic" name="topic">
            <option>Dispatch a technician</option>
            <option>Multi-site rollout</option>
            <option>Join as a technician</option>
            <option>Partnership</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field"><label for="message">Message</label><textarea id="message" name="message" required></textarea></div>
        <button class="btn btn--primary btn--block" type="submit">Send message <Icon name="arrow" /></button>
        <p class="form-note">By sending this form you agree to our <a href={u('/privacy/')} style="color:var(--purple)">Privacy Policy</a>.</p>
        <p class="form-success" role="status" data-success>{endpoint ? 'Thanks! Your message was sent. We’ll get back to you shortly.' : 'Thanks! Your email app should open with your message ready to send.'}</p>
        <p class="form-error" role="alert"><span data-error-text>Sorry, something went wrong.</span> Please email us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </form>
    </div>
  </section>
</Base>
