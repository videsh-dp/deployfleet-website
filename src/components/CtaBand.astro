---
import Icon from './Icon.astro';
import { appLinks } from '../data/site';
import { u } from '../lib/url';
interface Props { title?: string; text?: string }
const { title = 'Need coverage today?', text = 'Post a Job and dispatch the right tech fast.' } = Astro.props;
---
<section class="cta-band" aria-label="Get started">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn--white" href={appLinks.registerCompany}>Post a Job <Icon name="arrow" /></a>
      <a class="btn btn--outline" href={u('/technicians/')}>Join as a Technician</a>
    </div>
  </div>
</section>
