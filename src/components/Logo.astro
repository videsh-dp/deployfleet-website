---
import { u } from '../lib/url';
interface Props { variant?: 'dark' | 'light' }
const { variant = 'dark' } = Astro.props;
---
<a href={u('/')} class="logo" aria-label="DeployFleet home">
  <img src={u(`/img/logo-mark-${variant}.svg`)} alt="" width="44" height="27" />
  <span class="logo-text">Deploy<b>Fleet</b></span>
</a>
