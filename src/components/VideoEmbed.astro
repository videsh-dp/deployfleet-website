---
// Lightweight video: shows a poster + play button, loads the YouTube player only on click.
// Emits VideoObject schema so the video can appear in Google video results.
import Icon from './Icon.astro';
interface Props {
  youtubeId?: string;
  title: string;
  description: string;
  uploadDate?: string; // ISO date, required by Google for VideoObject
  poster?: string;
  duration?: string; // ISO 8601, e.g. PT1M30S
}
const { youtubeId, title, description, uploadDate, poster, duration } = Astro.props;
const thumb = poster ?? (youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : undefined);
const schema = youtubeId && uploadDate ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [thumb],
  uploadDate,
  ...(duration ? { duration } : {}),
  embedUrl: `https://www.youtube-nocookie.com/embed/${youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${youtubeId}`,
} : null;
---
<figure class="video" data-video={youtubeId} data-title={title}>
  {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />}
  {youtubeId ? (
    <button class="video-play" type="button" aria-label={`Play video: ${title}`}><Icon name="play" /></button>
  ) : (
    <div class="video-placeholder"><span class="video-play" aria-hidden="true"><Icon name="play" /></span><span>Video coming soon</span></div>
  )}
  <figcaption class="sr-only">{title}</figcaption>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</figure>

<style>
  .video { position: relative; margin: 0; aspect-ratio: 16 / 9; background: var(--gradient); overflow: hidden; border-radius: 4px; box-shadow: var(--shadow-lg); }
  .video img, .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .video-play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 76px; height: 76px; border-radius: 50%; border: 0; background: #fff; color: var(--purple);
    display: grid; place-items: center; cursor: pointer; box-shadow: 0 0 0 10px rgba(255,255,255,.25); transition: transform .2s;
  }
  .video-play:hover { transform: translate(-50%, -50%) scale(1.06); }
  .video-play :global(svg) { width: 28px; height: 28px; margin-left: 4px; }
  .video-placeholder { position: absolute; inset: 0; color: #fff; font-size: .9rem; }
  .video-placeholder span:last-child { position: absolute; bottom: 18px; left: 0; right: 0; text-align: center; opacity: .9; }
</style>
