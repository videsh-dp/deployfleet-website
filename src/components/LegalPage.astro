---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
const crumbs = [{ name: 'Home', path: '/' }, { name: title, path }];
---
<Base title={title} description={description} breadcrumbs={crumbs}>
  <PageHero eyebrow="Legal" title={title} text={`Last updated ${updated}`} crumbs={crumbs} />
  <section class="section">
    <div class="container legal">
      <slot />
    </div>
  </section>
</Base>
